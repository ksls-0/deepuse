# ============================================================
# 后端环境变量（复制本文件为 .env 并填入真实值）
# .env 已被 .gitignore 忽略，不会进仓库。
# 服务器上用 systemd EnvironmentFile=/opt/deepusecode/.env 加载。
# ============================================================

# ---- 数据库 ----
DB_USERNAME=root
DB_PASSWORD=change-me
# 若数据库不在本机或端口不同，覆盖整条 URL
# DB_URL=jdbc:mysql://127.0.0.1:3306/testlogin?useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&characterEncoding=utf8&createDatabaseIfNotExist=true

# ---- JWT ----
# 必须 >= 32 字符。生成方式：openssl rand -base64 48
# 注意：更换此值会让所有已登录用户掉线。
JWT_SECRET=change-me-at-least-32-characters-long

# ---- Redis（邮箱/手机号注册验证码的存储与限流）----
# 注册功能依赖 Redis：验证码、60 秒重发限制、每日发送上限都存在这里。
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ---- DeepSeek ----
# 留空则后端降级为结构化 mock，整条链路仍可跑通
DEEPSEEK_API_KEY=

# ---- AI 配额 ----
# 每用户 24h 内最多生成多少次角色，<=0 表示不限量
AI_DAILY_GENERATION_LIMIT=20

# ---- 邮件（邮箱验证码真实发送）----
# 不填 SPRING_MAIL_HOST 则验证码只打印到后端日志（本地开发模式）
# QQ 邮箱: SPRING_MAIL_HOST=smtp.qq.com  SPRING_MAIL_PORT=465
#          密码填「授权码」不是登录密码（QQ邮箱 设置→账户→开启SMTP→生成授权码）
# 163 邮箱: SPRING_MAIL_HOST=smtp.163.com SPRING_MAIL_PORT=465
# SPRING_MAIL_HOST=
# SPRING_MAIL_PORT=465
# SPRING_MAIL_USERNAME=
# SPRING_MAIL_PASSWORD=
# 发件人展示地址，可留空（默认用 SPRING_MAIL_USERNAME）
# MAIL_FROM=
# ---- 管理员 ----
# 逗号分隔，例如 admin@example.com,13800138000
APP_ADMIN_ACCOUNTS=

# ---- CORS ----
# 同源部署（前端 dist 打进本 jar）时不需要设置，留空即可。
# 前后端分域部署时填前端域名，多个用逗号分隔。
# APP_CORS_ALLOWED_ORIGINS=https://your-domain.com

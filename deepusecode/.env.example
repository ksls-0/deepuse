# ============================================================
# 后端环境变量（复制本文件为 .env 并填入真实值）
# .env 已被 .gitignore 忽略，不会进仓库。
# 服务器上用 systemd EnvironmentFile=/opt/deepusecode/.env 加载。
# ============================================================

# ---- 数据库 ----
DB_USERNAME=root
DB_PASSWORD=change-me
# 若数据库不在本机或端口不同，覆盖整条 URL
# DB_URL=jdbc:mysql://127.0.0.1:3306/testlogin?useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&characterEncoding=utf8&createDatabaseIfNotExist=true

# ---- JWT ----
# 必须 >= 32 字符。生成方式：openssl rand -base64 48
# 注意：更换此值会让所有已登录用户掉线。
JWT_SECRET=change-me-at-least-32-characters-long

# ---- DeepSeek ----
# 留空则后端降级为结构化 mock，整条链路仍可跑通
DEEPSEEK_API_KEY=

# ---- CORS ----
# 同源部署（前端 dist 打进本 jar）时不需要设置，留空即可。
# 前后端分域部署时填前端域名，多个用逗号分隔。
# APP_CORS_ALLOWED_ORIGINS=https://your-domain.com

# ============================================================
# Docker Compose 部署用的环境变量（复制为 .env 再填值）
#
#   cp .env.example .env && chmod 600 .env
#
# ⚠️ 两条铁律：
#   1. 不要用空值占位，用不到的项**整行注释掉**。
#      尤其是 SPRING_MAIL_* —— 留成空字符串会被 Spring 当成"已配置"，
#      于是真的去连一个空主机名，发验证码直接失败。
#   2. .env 已经写进 .gitignore，永远不要提交。
# ============================================================

# ---- MySQL 容器（首次启动时生效；之后改密码要动 volume，见部署文档 §6）----
# root 密码：容器内部管理用，不对外
MYSQL_ROOT_PASSWORD=换成强的随机密码
# 应用连库用的账号，compose 会自动创建并把 testlogin 库授权给它
MYSQL_PASSWORD=换成另一个强的随机密码

# ---- Redis ----
REDIS_PASSWORD=再换一个强的随机密码

# ---- JWT（必填，>=32 字符）----
# 生成：openssl rand -base64 48
# 换掉它 = 让所有已登录用户重新登录
JWT_SECRET=

# ---- DeepSeek（不填则降级为 mock，页面能跑但内容是占位的）----
# 申请：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# ---- AI 配额：每用户 24h 内最多生成多少次角色，<=0 不限量 ----
AI_DAILY_GENERATION_LIMIT=20

# ---- 管理员白名单（逗号分隔的邮箱/手机号）----
# 白名单里的账号注册即成为管理员；权限写在 JWT 里，改完要重新登录
APP_ADMIN_ACCOUNTS=

# ---- 邮件（邮箱验证码）----
# 需要真实发信时才取消注释并填真实值；不填则验证码只打到应用日志。
# QQ 邮箱：smtp.qq.com / 465 / 授权码（不是登录密码）
# 163 邮箱：smtp.163.com / 465
# SPRING_MAIL_HOST=smtp.qq.com
# SPRING_MAIL_PORT=465
# SPRING_MAIL_USERNAME=你的邮箱@qq.com
# SPRING_MAIL_PASSWORD=邮箱授权码

# ---- 镜像标签（回滚时用：APP_IMAGE_TAG=v1 docker compose up -d）----
APP_IMAGE_TAG=latest

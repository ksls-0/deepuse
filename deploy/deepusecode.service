[Unit]
Description=deepusecode (角色工坊)
# MySQL 与 Redis 都必须是本机时才用这两行；否则去掉对应依赖
After=network.target mysql.service redis-server.service
Wants=mysql.service redis-server.service

[Service]
Type=simple
User=appy
Group=appy
WorkingDirectory=/opt/deepusecode

# 所有密钥与数据库凭据都从这里注入，权限建议 chmod 600
EnvironmentFile=/opt/deepusecode/.env

ExecStart=/usr/bin/java \
  -Xms512m -Xmx1536m \
  -Duser.timezone=Asia/Shanghai \
  -Dfile.encoding=UTF-8 \
  -XX:+HeapDumpOnOutOfMemoryError -XX:HeapDumpPath=/opt/deepusecode/logs \
  -jar /opt/deepusecode/deepusecode-0.0.1-SNAPSHOT.jar

# 堆大小按机器规格调整：
#   2 核 4G -> -Xms512m  -Xmx1536m
#   2 核 2G -> -Xms256m  -Xmx768m   （并确保开了 swap，否则几个生成并发就会 OOM）
# -Duser.timezone 必须写，否则容器/JVM 可能按 UTC 走，日志时间比北京时间早 8 小时。

# 日志由 logback 写入 logs/，stdout 交给 journald
StandardOutput=journal
StandardError=journal

Restart=always
RestartSec=5s
SuccessExitStatus=143

# ---- 安全加固 ----
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/deepusecode/logs /opt/deepusecode/.data

[Install]
WantedBy=multi-user.target

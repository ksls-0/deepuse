# 统一由本文件管理换行符，不依赖各台机器上的 core.autocrlf 设置。
# 目的：在 Windows 上开发、部署到 Linux 时，Shell 脚本与配置文件必须是 LF，
# 否则会出现 "bad interpreter: /bin/bash^M" 这类问题。

* text=auto

# 部署到 Linux 后必须保持 LF 的文件
*.sh                text eol=lf
*.properties        text eol=lf
*.conf              text eol=lf
*.service           text eol=lf
Dockerfile          text eol=lf
*.sql               text eol=lf

# Windows 专用脚本保持 CRLF
*.cmd               text eol=crlf
*.bat               text eol=crlf

# 二进制文件不做换行转换
*.jar               binary
*.png               binary
*.jpg               binary
*.ico               binary
*.woff              binary
*.woff2             binary
